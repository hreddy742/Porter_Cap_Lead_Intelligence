# Secrets — never commit
.env
.env.staging
*.env.local

# Python
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Docker volumes
postgres_data/

# Alembic — keep versions, ignore pycache
alembic/versions/__pycache__/

# Logs
*.log
logs/

# SBA loan cache — 150 MB bulk CSV, regenerated on first run
data/sba_loans_cache.csv

# OFAC SDN list — ~5 MB, must be downloaded manually, must never be committed
data/ofac_sdn.csv

# Exports — keep directory tracked, ignore generated CSVs
exports/*.csv

# Backups — ignore entirely
backups/

# Runtime output artifacts
outputs/

# Error logs and debug scripts
api.err
frontend.err
test_both_keys.py
test_sam.py
check_usa.py
