# Copy this file to .env and fill in real values.
# Never commit .env to git.

# ── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://porter:localdev@localhost:5432/porter_leads
POSTGRES_PASSWORD=localdev

# ── Monitoring ──────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=
HEALTHCHECKS_URL=

# ── Auth (Phase 1: leave empty; configure in Week 5) ───
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=yourcompany.com

# ── Phase 2+: Contactability-Lite ──────────────────────
# Search provider for website discovery (e.g. 'brave', 'serpapi')
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_RATE_LIMIT_PER_MINUTE=10

# SAM.gov entity match API key (public data, requires key registration)
SAM_GOV_API_KEY=
SAM_RATE_LIMIT_PER_MINUTE=60

# Website fetching safety controls
WEBSITE_FETCH_TIMEOUT_SECONDS=30

# ── Phase 3: Salesforce ─────────────────────────────────
SF_CONSUMER_KEY=
SF_CONSUMER_SECRET=
SF_USERNAME=
SF_SECURITY_TOKEN=
SF_DOMAIN=login

# ── Pipeline config ─────────────────────────────────────
PIPELINE_LOOKBACK_DAYS=30
PIPELINE_MIN_AWARD_AMOUNT=100000
LOG_LEVEL=INFO

# ── Award amount quality gates (Gate 10) ────────────────
# A company passes Gate 10 if its largest single positive award >= the single
# threshold, OR its total positive awards in the last 90 days >= the 90-day
# threshold. Negative and zero amounts never count toward qualification.
# MIN_QUALIFYING_SINGLE_AWARD_AMOUNT=10000
# MIN_QUALIFYING_COMPANY_90D_AWARD_TOTAL=10000

# ── USASpending connector — operational cap ──────────────
# Maximum number of pages fetched per run (100 records/page → 200 pages = 20 000 records).
# This is a controlled operational cap to reduce failed long-running pulls.
# It does NOT mean one run covers the full USASpending universe — the fiscal year
# corpus is larger and will be covered across multiple daily runs over time.
# Increase with caution: the USASpending API disconnects on very long sessions.
USASPENDING_MAX_PAGES=200

# ── USASpending connector — retry / timeout ──────────────
# Seconds before an individual API request times out (default: 30).
# USASPENDING_TIMEOUT_SECONDS=30
# Max number of retries after a transient failure (429, 5xx, timeout).
# 3 retries = 4 total attempts. Set to 0 to disable retries (default: 3).
# USASPENDING_MAX_RETRIES=3
# Base delay in seconds for exponential backoff: delay = base * 2^(attempt-1) + jitter.
# USASPENDING_BACKOFF_BASE_SECONDS=2.0
# Maximum delay cap in seconds regardless of backoff calculation (default: 60).
# USASPENDING_BACKOFF_MAX_SECONDS=60.0
