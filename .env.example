# Copy this file to .env and fill in real values.
# Never commit .env to git.

# ── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://porter:localdev@localhost:5432/porter_leads
POSTGRES_PASSWORD=localdev

# ── Monitoring ──────────────────────────────────────────
SENTRY_DSN=
HEALTHCHECKS_URL=

# ── Auth (Phase 1: leave empty; configure in Week 5) ───
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=yourcompany.com

# ── Phase 2+ ────────────────────────────────────────────
SAM_GOV_API_KEY=

# ── Phase 3: Salesforce ─────────────────────────────────
SF_CONSUMER_KEY=
SF_CONSUMER_SECRET=
SF_USERNAME=
SF_SECURITY_TOKEN=
SF_DOMAIN=login

# ── Pipeline config ─────────────────────────────────────
PIPELINE_LOOKBACK_DAYS=30
PIPELINE_MIN_AWARD_AMOUNT=100000
LOG_LEVEL=INFO

# ── Award amount quality gates (Gate 10) ────────────────
# A company passes Gate 10 if its largest single positive award >= the single
# threshold, OR its total positive awards in the last 90 days >= the 90-day
# threshold. Negative and zero amounts never count toward qualification.
# MIN_QUALIFYING_SINGLE_AWARD_AMOUNT=10000
# MIN_QUALIFYING_COMPANY_90D_AWARD_TOTAL=10000
