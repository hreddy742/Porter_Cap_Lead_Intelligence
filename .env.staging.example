# Copy this file to .env.staging and fill in real values.
# Never commit .env.staging to git.
#
# This file configures the STAGING environment.
# Staging database : porter_leads_staging
# Staging DB port  : 5433  (dev runs on 5432 -- no conflict)
# Staging dashboard: http://localhost:8502  (dev runs on 8501)

# -- Database -----------------------------------------------------------------
DATABASE_URL=postgresql://porter:localdev@localhost:5433/porter_leads_staging
POSTGRES_PASSWORD=localdev

# -- Monitoring ---------------------------------------------------------------
# Leave SENTRY_DSN blank unless you have a dedicated staging Sentry project.
# Do NOT copy the production DSN here.
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=

# -- Health checks ------------------------------------------------------------
HEALTHCHECKS_URL=

# -- Auth (Phase 1: leave empty) ---------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=yourcompany.com

# -- Phase 2+: Contactability-Lite --------------------------------------------
# Do not put real API keys in staging unless explicitly approved.
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_RATE_LIMIT_PER_MINUTE=10
# Do not put a real SAM.gov API key in staging unless explicitly approved.
SAM_GOV_API_KEY=
SAM_RATE_LIMIT_PER_MINUTE=60
WEBSITE_FETCH_TIMEOUT_SECONDS=30

# -- Phase 3: Salesforce ------------------------------------------------------
# WARNING: Never configure real Salesforce credentials in staging.
# Staging must never push data to Salesforce.
SF_CONSUMER_KEY=
SF_CONSUMER_SECRET=
SF_USERNAME=
SF_SECURITY_TOKEN=
SF_DOMAIN=login

# -- Pipeline config ----------------------------------------------------------
# Short lookback + high minimum limits data volume during intentional staging runs.
PIPELINE_LOOKBACK_DAYS=3
PIPELINE_MIN_AWARD_AMOUNT=100000
LOG_LEVEL=INFO

# -- Award amount quality gates (Gate 10) ------------------------------------
# Uncomment to override defaults during staging tests.
# MIN_QUALIFYING_SINGLE_AWARD_AMOUNT=10000
# MIN_QUALIFYING_COMPANY_90D_AWARD_TOTAL=10000

# -- USASpending connector -- operational cap ---------------------------------
# Controlled cap per run to avoid server-side disconnects on long pulls.
# This does NOT mean one run covers the full USASpending universe.
# Staging intentionally uses the same cap as production (200 pages).
# For quick smoke tests use USASPENDING_MAX_PAGES=1 on the command line.
USASPENDING_MAX_PAGES=200

# -- USASpending connector -- retry / timeout ---------------------------------
# USASPENDING_TIMEOUT_SECONDS=30
# USASPENDING_MAX_RETRIES=3
# USASPENDING_BACKOFF_BASE_SECONDS=2.0
# USASPENDING_BACKOFF_MAX_SECONDS=60.0
